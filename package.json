{
  "name": "be-setpoint",
  "private": true,
  "version": "0.1.0",
  "description": "Set Point backend — NestJS services, Prisma schema, and architecture docs",
  "scripts": {
    "postinstall": "prisma generate",
    "build": "prisma generate && nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "test": "npm run test:drawing && npm run test:schedule && npm run test:match && npm run test:scoring && npm run test:standing && npm run test:playoff && npm run test:prisma-errors",
    "test:drawing": "ts-node --transpile-only src/drawing/engine/drawing-generator.spec.ts",
    "test:schedule": "ts-node --transpile-only src/schedule/engine/schedule-generator.spec.ts",
    "test:match": "ts-node --transpile-only src/match/match.lifecycle.spec.ts",
    "test:scoring": "ts-node --transpile-only src/match/scoring/scoring-engine.spec.ts",
    "test:standing": "ts-node --transpile-only src/standing/engine/standing-calculator.spec.ts",
    "test:playoff": "ts-node --transpile-only src/playoff/engine/playoff-bracket-generator.spec.ts",
    "test:prisma-errors": "ts-node --transpile-only src/common/filters/prisma-exception.mapper.spec.ts",
    "simulate": "ts-node --transpile-only scripts/simulate-tournament.ts"
  },
  "prisma": {
    "seed": "npx ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "^11.4.6",
    "@prisma/client": "^6.19.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prisma": "^6.19.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/swagger-ui-express": "^4.1.8",
    "source-map-support": "^0.5.21",
    "tsconfig-paths": "^4.2.0"
  }
}
