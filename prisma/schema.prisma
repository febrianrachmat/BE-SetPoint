  rowVersion          Int   @default(1) @map("row_version")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.Uuid

  category           Category             @relation("CategoryMatches", fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  group              Group?               @relation("GroupMatches", fields: [groupId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  playoff            Playoff?             @relation("PlayoffMatches", fields: [playoffId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  bracket            Bracket?             @relation("BracketMatches", fields: [bracketId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  scheduleVersion    ScheduleVersion?     @relation("MatchScheduleVersion", fields: [scheduleVersionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  court              Court?               @relation("MatchCourt", fields: [courtId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  participations     MatchParticipation[] @relation("MatchParticipations")
  scheduleEntries    ScheduleEntry[]      @relation("ScheduleEntryMatch")
  refereeAssignments RefereeAssignment[]  @relation("MatchRefereeAssignments")

  @@index([categoryId], map: "idx_matches_category")
  @@index([status], map: "idx_matches_status")
  @@index([courtId], map: "idx_matches_court")
  @@index([groupId], map: "idx_matches_group")
  @@index([playoffId], map: "idx_matches_playoff")
  @@index([categoryId, status], map: "idx_matches_category_status")
  @@map("matches")
}

model MatchParticipation {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  matchId String @map("match_id") @db.Uuid
  teamId  String @map("team_id") @db.Uuid

  sideLabel                 String @map("side_label") @db.VarChar(20)
  playerCompositionSnapshot Json?  @map("player_composition_snapshot") @db.JsonB

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  match Match @relation("MatchParticipations", fields: [matchId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  team  Team  @relation("TeamMatchParticipations", fields: [teamId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([matchId, sideLabel], map: "uq_match_participations_match_side")
  @@unique([matchId, teamId], map: "uq_match_participations_match_team")
  @@index([teamId], map: "idx_match_participations_team")
  @@map("match_participations")
}

model Standing {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  categoryId String  @map("category_id") @db.Uuid
  groupId    String? @map("group_id") @db.Uuid
  teamId     String  @map("team_id") @db.Uuid

  rankPosition       Int?      @map("rank_position")
  matchesPlayed      Int       @default(0) @map("matches_played")
  wins               Int       @default(0)
  losses             Int       @default(0)
  points             Int       @default(0)
  tieBreakNotes      String?   @map("tie_break_notes")
  lastRecalculatedAt DateTime? @map("last_recalculated_at") @db.Timestamptz(6)

  qualificationStatus QualificationStatus @default(not_qualified) @map("qualification_status")
  publishState        PublishState        @default(unpublished) @map("publish_state")
  publishedAt         DateTime?           @map("published_at") @db.Timestamptz(6)
  publishedBy         String?             @map("published_by") @db.Uuid

  lockState    LockState @default(unlocked) @map("lock_state")
  lockedAt     DateTime? @map("locked_at") @db.Timestamptz(6)
  lockedBy     String?   @map("locked_by") @db.Uuid
  unlockReason String?   @map("unlock_reason")
  unlockedAt   DateTime? @map("unlocked_at") @db.Timestamptz(6)
  unlockedBy   String?   @map("unlocked_by") @db.Uuid

  rowVersion Int @default(1) @map("row_version")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.Uuid

  category Category @relation("CategoryStandings", fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  group    Group?   @relation("GroupStandings", fields: [groupId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  team     Team     @relation("StandingTeam", fields: [teamId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([categoryId, teamId, groupId], map: "uq_standings_category_team_group")
  @@index([categoryId], map: "idx_standings_category")
  @@index([teamId], map: "idx_standings_team")
  @@map("standings")
}

model ScheduleEntry {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  scheduleVersionId String  @map("schedule_version_id") @db.Uuid
  matchId           String  @map("match_id") @db.Uuid
  courtId           String? @map("court_id") @db.Uuid

  scheduledStartAt DateTime  @map("scheduled_start_at") @db.Timestamptz(6)
  scheduledEndAt   DateTime? @map("scheduled_end_at") @db.Timestamptz(6)
  sequenceOrder    Int       @map("sequence_order")
  rescheduleFlag   Boolean   @default(false) @map("reschedule_flag")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  scheduleVersion ScheduleVersion @relation("ScheduleEntries", fields: [scheduleVersionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  match           Match           @relation("ScheduleEntryMatch", fields: [matchId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  court           Court?          @relation("ScheduleEntryCourt", fields: [courtId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([scheduleVersionId, matchId], map: "uq_schedule_entries_version_match")
  @@index([scheduleVersionId], map: "idx_schedule_entries_version")
  @@index([courtId, scheduledStartAt], map: "idx_schedule_entries_court_time")
  @@map("schedule_entries")
}

// -----------------------------------------------------------------------------
// Playoff Models
// -----------------------------------------------------------------------------

model Playoff {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  categoryId               String  @unique(map: "uq_playoffs_category") @map("category_id") @db.Uuid
  currentOfficialBracketId String? @unique @map("current_official_bracket_id") @db.Uuid

  qualificationBasis String? @map("qualification_basis")

  reviewStatus ReviewStatus @default(pending) @map("review_status")
  publishState PublishState @default(unpublished) @map("publish_state")
  publishedAt  DateTime?    @map("published_at") @db.Timestamptz(6)
  publishedBy  String?      @map("published_by") @db.Uuid

  lockState    LockState @default(unlocked) @map("lock_state")
  lockedAt     DateTime? @map("locked_at") @db.Timestamptz(6)
  lockedBy     String?   @map("locked_by") @db.Uuid
  unlockReason String?   @map("unlock_reason")
  unlockedAt   DateTime? @map("unlocked_at") @db.Timestamptz(6)
  unlockedBy   String?   @map("unlocked_by") @db.Uuid

  rowVersion Int @default(1) @map("row_version")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.Uuid

  category               Category  @relation("CategoryPlayoff", fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  currentOfficialBracket Bracket?  @relation("PlayoffOfficialBracket", fields: [currentOfficialBracketId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  brackets               Bracket[] @relation("PlayoffBrackets")
  matches                Match[]   @relation("PlayoffMatches")
  champion               Champion? @relation("PlayoffChampion")

  @@map("playoffs")
}

model Bracket {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  playoffId String @map("playoff_id") @db.Uuid

  versionNumber    Int     @map("version_number")
  officialFlag     Boolean @default(false) @map("official_flag")
  generationSource String  @default("engine") @map("generation_source") @db.VarChar(50)

  versionStatus VersionStatus @default(candidate) @map("version_status")
  publishState  PublishState  @default(unpublished) @map("publish_state")
  publishedAt   DateTime?     @map("published_at") @db.Timestamptz(6)
  publishedBy   String?       @map("published_by") @db.Uuid

  lockState    LockState @default(unlocked) @map("lock_state")
  lockedAt     DateTime? @map("locked_at") @db.Timestamptz(6)
  lockedBy     String?   @map("locked_by") @db.Uuid
  unlockReason String?   @map("unlock_reason")
  unlockedAt   DateTime? @map("unlocked_at") @db.Timestamptz(6)
  unlockedBy   String?   @map("unlocked_by") @db.Uuid

  structureRepresentation Json @map("structure_representation") @db.JsonB

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.Uuid

  playoff            Playoff  @relation("PlayoffBrackets", fields: [playoffId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  officialForPlayoff Playoff? @relation("PlayoffOfficialBracket")
  matches            Match[]  @relation("BracketMatches")

  @@unique([playoffId, versionNumber], map: "uq_brackets_playoff_number")
  @@index([playoffId], map: "idx_brackets_playoff")
  @@map("brackets")
}

model Champion {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  playoffId     String @unique(map: "uq_champions_playoff") @map("playoff_id") @db.Uuid
  categoryId    String @map("category_id") @db.Uuid
  winningTeamId String @map("winning_team_id") @db.Uuid

  declarationStatus DeclarationStatus @default(declared) @map("declaration_status")
  declaredAt        DateTime          @default(now()) @map("declared_at") @db.Timestamptz(6)
  declaredBy        String?           @map("declared_by") @db.Uuid

  playoff     Playoff  @relation("PlayoffChampion", fields: [playoffId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  category    Category @relation("ChampionCategory", fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  winningTeam Team     @relation("ChampionTeam", fields: [winningTeamId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("champions")
}

