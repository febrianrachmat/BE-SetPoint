model Review {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  artifactId String  @map("artifact_id") @db.Uuid
  versionId  String  @map("version_id") @db.Uuid
  reviewerId String? @map("reviewer_id") @db.Uuid

  notes      String?
  reviewedAt DateTime? @map("reviewed_at") @db.Timestamptz(6)

  artifactType ArtifactType  @map("artifact_type")
  status       ReviewStatus  @default(pending)
  decision     ReviewStatus?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([artifactType, artifactId], map: "idx_reviews_artifact")
  @@map("reviews")
}

model RefereeAssignment {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  matchId    String  @map("match_id") @db.Uuid
  refereeId  String  @map("referee_id") @db.Uuid
  assignedBy String? @map("assigned_by") @db.Uuid

  assignedAt   DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(6)
  unassignedAt DateTime? @map("unassigned_at") @db.Timestamptz(6)

  assignmentStatus AssignmentStatus @default(active) @map("assignment_status")

  match Match @relation("MatchRefereeAssignments", fields: [matchId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([refereeId], map: "idx_referee_assignments_referee")
  @@map("referee_assignments")
}

model AuditLog {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  tournamentId     String? @map("tournament_id") @db.Uuid
  actorId          String? @map("actor_id") @db.Uuid
  affectedEntityId String  @map("affected_entity_id") @db.Uuid
  relatedVersionId String? @map("related_version_id") @db.Uuid

  actionType         String  @map("action_type") @db.VarChar(100)
  affectedEntityType String  @map("affected_entity_type") @db.VarChar(100)
  reason             String?

  previousOfficialState Json? @map("previous_official_state") @db.JsonB
  newOfficialState      Json? @map("new_official_state") @db.JsonB

  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  tournament Tournament? @relation("TournamentAuditLogs", fields: [tournamentId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([tournamentId, occurredAt], map: "idx_audit_logs_tournament_time")
  @@map("audit_logs")
}

model EventLog {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  tournamentId    String? @map("tournament_id") @db.Uuid
  relatedEntityId String? @map("related_entity_id") @db.Uuid

  eventType         String  @map("event_type") @db.VarChar(100)
  relatedEntityType String? @map("related_entity_type") @db.VarChar(100)
  eventMeaning      String  @map("event_meaning")

  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  tournament Tournament? @relation("TournamentEventLogs", fields: [tournamentId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([tournamentId, occurredAt], map: "idx_event_logs_tournament_time")
  @@map("event_logs")
}
